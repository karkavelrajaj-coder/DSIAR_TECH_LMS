# Copy to .env for local dev. On Render, set these as the Web Service's
# Environment Variables instead — never commit a real .env file.

# Same free Atlas cluster as the Streamlit app, but a DIFFERENT database name
# (below) so the Streamlit app's own data/collections are never touched.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.ua3bzky.mongodb.net
DB_NAME=dsiar_lms_v2

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SEED_ADMIN_EMAIL=admin@dsiar.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=D'siar Tech Admin

DIGITALSAMBA_TEAM_ID=
DIGITALSAMBA_DEVELOPER_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
